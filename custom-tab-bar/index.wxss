.tab-bar{position:fixed;bottom:0;left:0;right:0;background:#fffdf7;border-top:1rpx solid #e4d8c5;display:flex;align-items:flex-start;padding:22rpx 22rpx calc(24rpx + env(safe-area-inset-bottom));z-index:20;color:#ac9c80}.tab-item{width:33.3333%;background:none;border:0;padding:0;margin:0;font-size:21rpx;line-height:1.7;display:flex;flex-direction:column;align-items:center}.tab-item::after{border:0}.icon-pill{padding:7rpx 31rpx;border-radius:30rpx;margin-bottom:5rpx;display:flex}.active{color:#876c42}.active .icon-pill{background:#f6e9c9}.theme-cherry{background:#fffaf7}.theme-cherry .active{color:#a35965}.theme-cherry .active .icon-pill{background:#f7dfe2}.theme-mint{background:#fff}.theme-mint .active{color:#526f63}.theme-mint .active .icon-pill{background:#e2ece5}
