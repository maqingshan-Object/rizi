<view class="tab-bar theme-{{theme}}"><button wx:for="{{list}}" wx:key="path" data-index="{{index}}" bindtap="switchTab" class="tab-item {{selected===index?'active':''}}" aria-label="{{item.text}}"><view class="icon-pill"><app-icon name="{{item.icon}}" size="43" /></view><text>{{item.text}}</text></button></view>
