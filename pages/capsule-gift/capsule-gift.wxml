<view class="app-page theme-{{theme}} subpage">
  <nav-header title="一段封存的话" theme="{{theme}}" />
  <view class="page-body gift-body">

    <view wx:if="{{loading}}" class="paper gift-paper">
      <text class="gift-hint">正在打开…</text>
    </view>

    <view wx:elif="{{error}}" class="paper gift-paper">
      <text class="gift-title">打不开这张卡片</text>
      <text class="gift-hint">{{error}}</text>
      <button class="btn-secondary gift-actions" bindtap="onHome">回到日子绵绵</button>
    </view>

    <block wx:else>
      <view class="paper gift-paper">
        <text class="gift-from">{{gift.senderName}} 写给你的</text>
        <text class="gift-title">{{gift.title}}</text>

        <!-- 还没到启封日：只给倒计时与打码，看不到正文 -->
        <block wx:if="{{!gift.openable}}">
          <view class="mask-lines"><view class="mask-line a"></view><view class="mask-line b"></view></view>
          <view class="gift-countdown"><text class="num">{{gift.daysLeft}}</text><text class="unit">天后启封</text></view>
          <text class="gift-date">{{gift.openOn}} 才能打开</text>
          <text class="gift-hint">到那天，可以在这里读；如果收下了，我们也会提醒你。</text>
        </block>

        <!-- 到启封日了：直接读到内容 -->
        <block wx:else>
          <text class="gift-content">{{gift.content}}</text>
          <text class="gift-date">{{gift.openOn}} 启封</text>
        </block>

        <button wx:if="{{canClaim}}" class="btn-primary gift-actions" bindtap="onClaim" disabled="{{claiming}}">
          {{claiming ? '正在收下…' : '收下这份心意'}}
        </button>
      </view>

      <text class="gift-footer">「日子绵绵」帮你把重要的日子放在心上{{'\n'}}收下后，你也可以把这份心意传下去</text>
      <button class="btn-secondary gift-actions" bindtap="onWrite">我也写一份送出去</button>
    </block>
    <view class="safe-bottom"></view>
  </view>
</view>
