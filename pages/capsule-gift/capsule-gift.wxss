.gift-body { padding-top: 40rpx; }
.gift-paper { padding: 44rpx 36rpx; text-align: center; }
.gift-from { display: block; font-size: 24rpx; color: var(--muted); }
.gift-title { display: block; font-size: 34rpx; font-weight: 600; margin: 16rpx 0 8rpx; }
.gift-hint { display: block; font-size: 21rpx; color: var(--muted); line-height: 1.9; }
.mask-lines { margin: 30rpx 0 10rpx; }
.mask-lines .mask-line { display: block; height: 22rpx; border-radius: 11rpx; background: #e7dcc7; margin: 0 auto 14rpx; }
.mask-lines .mask-line.a { width: 78%; }
.mask-lines .mask-line.b { width: 52%; }
.gift-countdown { display: flex; align-items: baseline; justify-content: center; margin: 30rpx 0 8rpx; }
.gift-countdown .num { font-family: 'Avenir Next', sans-serif; font-size: 110rpx; font-weight: 600; color: var(--accent); letter-spacing: -3rpx; }
.gift-countdown .unit { font-size: 26rpx; color: var(--muted); margin-left: 12rpx; }
.gift-date { display: block; font-size: 21rpx; color: var(--muted); }
.gift-content { display: block; text-align: left; font-size: 28rpx; line-height: 2.1; white-space: pre-wrap; margin: 24rpx 0 8rpx; }
.gift-actions { margin-top: 34rpx; }
.gift-footer { display: block; text-align: center; font-size: 20rpx; color: var(--muted); line-height: 1.9; margin-top: 24rpx; }
