.edit-body { padding-top: 20rpx; }
.kind-switch { display: flex; gap: 16rpx; margin-bottom: 26rpx; }
.kind-switch button { flex: 1; padding: 22rpx; border-radius: 24rpx; font-size: 24rpx; background: var(--paper); border: 1rpx solid #d9ceba66; }
.kind-switch button.active { background: var(--soft); border-color: var(--accent); color: var(--accent); font-weight: 500; }
.cap-textarea { width: 100%; min-height: 320rpx; background: var(--paper); border: 1rpx solid #dccfb6; border-radius: 22rpx; padding: 24rpx; font-size: 26rpx; line-height: 1.9; }
.counter { display: block; text-align: right; font-size: 20rpx; color: var(--muted); margin-top: 10rpx; }
.read-paper { padding: 34rpx 30rpx; }
.read-content { display: block; font-size: 28rpx; line-height: 2.1; white-space: pre-wrap; }
.read-foot { display: block; text-align: right; font-size: 21rpx; color: var(--muted); margin-top: 26rpx; }
