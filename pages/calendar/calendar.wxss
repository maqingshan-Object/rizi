.app-page {
  --cal-ink: #594d3e;
  --cal-muted: #a39580;
  --cal-accent: #876c42;
  --cal-soft: #f6e9c9;
  --cal-paper: #fffdf7;
  --cal-line: rgba(135, 108, 66, 0.12);
  --cal-pink: #f2d8d6;
  --cal-mint: #e2eadb;
  --cal-yellow: #f7e8bf;
  --cal-blue: #dfe9ed;
  min-height: 100vh;
  color: var(--cal-ink);
}
.theme-cherry {
  --cal-ink: #70535a;
  --cal-muted: #ab8c91;
  --cal-accent: #a35965;
  --cal-soft: #f7dfe2;
  --cal-paper: #fffaf7;
  --cal-line: rgba(163, 89, 101, 0.13);
  --cal-pink: #f2cdd2;
  --cal-mint: #e9e7d8;
  --cal-yellow: #f5e4cc;
  --cal-blue: #eae2e5;
}
.theme-mint {
  --cal-ink: #4d6258;
  --cal-muted: #91a096;
  --cal-accent: #526f63;
  --cal-soft: #e2ece5;
  --cal-paper: #ffffff;
  --cal-line: rgba(82, 111, 99, 0.12);
  --cal-pink: #ede8e0;
  --cal-mint: #dfeadf;
  --cal-yellow: #ece9de;
  --cal-blue: #e0e8e6;
}
.calendar-content {
  padding: 12rpx 36rpx 190rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.calendar-content button, .page-fab {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: inherit;
  font-weight: normal;
  line-height: 1.5;
  color: inherit;
}
.calendar-content button::after, .page-fab::after { border: 0; }
.guest-banner { display: flex; align-items: center; padding: 12rpx 18rpx; margin-bottom: 28rpx; border-radius: 14rpx; background: rgba(135, 108, 66, 0.06); color: var(--cal-muted); font-size: 21rpx; line-height: 1.5; }
.guest-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--cal-accent); margin-right: 12rpx; flex-shrink: 0; opacity: 0.65; }
.calendar-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.month-heading { flex: 1; min-width: 0; }
.month-title { display: block; font-size: 43rpx; font-weight: 600; letter-spacing: -1rpx; }
.month-subtitle { display: block; margin-top: 11rpx; color: var(--cal-muted); font-size: 21rpx; }
.calendar-controls { display: flex; align-items: center; margin-left: 12rpx; }
.calendar-controls .month-arrow { width: 56rpx; height: 68rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: transparent; }
.calendar-controls .today-button { width: 55rpx; height: 55rpx; border-radius: 50%; background: var(--cal-soft); color: var(--cal-accent); font-size: 23rpx; display: flex; align-items: center; justify-content: center; margin: 0 6rpx; }
.calendar-controls button[disabled] { opacity: 0.4; }
.calendar-paper { padding: 27rpx 12rpx 24rpx; border: 1rpx solid var(--cal-line); border-radius: 38rpx; background: var(--cal-paper); }
.week-labels { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin-bottom: 13rpx; }
.week-label { text-align: center; font-size: 22rpx; color: var(--cal-muted); line-height: 42rpx; }
.weekend-label { color: #b39389; }
.calendar-cells { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-cells .day-cell { position: relative; width: 100%; height: 110rpx; min-width: 0; border-radius: 19rpx; background: transparent; display: flex; flex-direction: column; align-items: center; overflow: visible; }
.date-number { display: block; width: 55rpx; height: 55rpx; margin-top: 9rpx; line-height: 55rpx; border-radius: 50%; font-size: 27rpx; text-align: center; font-family: 'SF Pro Display', 'Helvetica Neue', sans-serif; box-sizing: border-box; }
.lunar-label { display: block; max-width: 100%; box-sizing: border-box; height: 25rpx; padding: 0 2rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #b0a38e; font-size: 17rpx; line-height: 25rpx; }
.holiday-label { color: #b77d72; }
.is-weekend .date-number { color: #b39389; }
.is-outside .date-number, .is-outside .lunar-label { color: #cec6b8; }
.has-events .date-number { border: 1rpx solid rgba(186, 125, 137, 0.45); }
.is-selected { background: var(--cal-soft) !important; }
.is-selected .date-number { color: var(--cal-accent); font-weight: 600; }
.is-today .date-number { background: var(--cal-accent); color: #fffdf7; border-color: transparent; }
.day-badge { position: absolute; right: 3rpx; top: 2rpx; width: 23rpx; height: 23rpx; line-height: 23rpx; text-align: center; font-size: 16rpx; border-radius: 6rpx; }
.rest-badge { background: #f3ded7; color: #b77463; }
.work-badge { background: #ebe0c6; color: #9b7c4d; }
.event-dots { position: absolute; bottom: 7rpx; display: flex; align-items: center; justify-content: center; height: 9rpx; }
.event-dot { width: 7rpx; height: 7rpx; border-radius: 50%; margin: 0 2rpx; }
.event-dot.tint-pink { background: #c58c93; }
.event-dot.tint-mint { background: #8fa78e; }
.event-dot.tint-yellow { background: #c9a96a; }
.event-dot.tint-blue { background: #92aeb8; }
.more-dots { font-size: 15rpx; line-height: 14rpx; color: var(--cal-muted); margin-left: 2rpx; }
.calendar-legend { display: flex; align-items: center; margin: 22rpx 13rpx 0; padding-top: 19rpx; border-top: 1rpx solid var(--cal-line); font-size: 19rpx; color: var(--cal-muted); }
.legend-item { display: flex; align-items: center; margin-right: 22rpx; }
.legend-item:last-child { margin-right: 0; }
.legend-badge { font-size: 15rpx; width: 25rpx; height: 25rpx; line-height: 25rpx; text-align: center; border-radius: 6rpx; margin-right: 8rpx; }
.legend-dot { width: 8rpx; height: 8rpx; background: #c58c93; border-radius: 50%; margin-right: 9rpx; }
.selection-summary { display: flex; align-items: center; justify-content: space-between; background: rgba(135, 108, 66, 0.045); border-radius: 23rpx; padding: 22rpx 24rpx; margin-top: 23rpx; }
.selected-heading { flex: 1; min-width: 0; }
.selected-date { display: block; font-size: 26rpx; font-weight: 500; }
.selected-meta { display: block; margin-top: 6rpx; color: var(--cal-muted); font-size: 20rpx; line-height: 1.5; }
.selected-total { color: var(--cal-accent); background: var(--cal-soft); padding: 7rpx 15rpx; border-radius: 25rpx; font-size: 19rpx; margin-left: 15rpx; flex-shrink: 0; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 2rpx 19rpx; font-size: 27rpx; font-weight: 500; }
.section-heading .inline-add { display: flex; align-items: center; background: transparent; padding: 5rpx 7rpx; font-size: 21rpx; font-weight: normal; color: var(--cal-accent); }
.inline-add app-icon { margin-right: 5rpx; }
.section-count { color: var(--cal-muted); font-size: 20rpx; font-weight: normal; }
.calendar-content .schedule { display: flex; align-items: center; width: 100%; margin-bottom: 17rpx; padding: 25rpx 24rpx; border-radius: 30rpx; border: 1rpx solid var(--cal-line); background: var(--cal-paper); text-align: left; }
.schedule-icon { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 23rpx; margin-right: 20rpx; flex-shrink: 0; }
.tint-pink { background: var(--cal-pink); }
.tint-mint { background: var(--cal-mint); }
.tint-yellow { background: var(--cal-yellow); }
.tint-blue { background: var(--cal-blue); }
.schedule-info { flex: 1; min-width: 0; }
.schedule-name { display: block; font-size: 24rpx; font-weight: 500; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.schedule-meta { display: block; font-size: 18rpx; color: var(--cal-muted); margin-top: 7rpx; line-height: 1.6; }
.schedule-tail { font-size: 20rpx; color: var(--cal-muted); margin-left: 15rpx; flex-shrink: 0; }
.schedule-tail.is-current { color: var(--cal-accent); }
.schedule-chevron { display: flex; margin-left: 8rpx; color: var(--cal-muted); flex-shrink: 0; }
.schedule-date { text-align: center; padding-right: 18rpx; margin-right: 18rpx; border-right: 1rpx solid var(--cal-line); min-width: 51rpx; flex-shrink: 0; }
.schedule-day { display: block; font-size: 39rpx; line-height: 1.1; font-family: 'SF Pro Display', 'Helvetica Neue', sans-serif; font-weight: 500; }
.schedule-month { display: block; color: var(--cal-muted); font-size: 18rpx; margin-top: 6rpx; }
.month-schedule .schedule-icon { width: 57rpx; height: 57rpx; border-radius: 19rpx; margin-right: 16rpx; }
.selected-empty { display: flex; align-items: center; padding: 24rpx; border: 1rpx dashed var(--cal-line); border-radius: 26rpx; background: rgba(135, 108, 66, 0.025); }
.empty-icon { display: flex; color: var(--cal-accent); margin-right: 17rpx; flex-shrink: 0; }
.empty-copy { color: var(--cal-muted); font-size: 23rpx; line-height: 1.8; }
.month-empty, .page-state { background: var(--cal-paper); border-radius: 30rpx; padding: 38rpx 28rpx; text-align: center; }
.state-icon { display: flex; justify-content: center; color: var(--cal-accent); margin-bottom: 19rpx; }
.state-title { display: block; font-size: 27rpx; font-weight: 500; }
.state-description { display: block; font-size: 23rpx; color: var(--cal-muted); line-height: 1.9; margin-top: 13rpx; }
.calendar-content .state-action { display: inline-block; background: var(--cal-accent); color: #fffdf7; padding: 18rpx 35rpx; font-size: 25rpx; border-radius: 25rpx; margin-top: 25rpx; }
.calendar-note { font-size: 20rpx; line-height: 1.8; color: var(--cal-muted); padding: 20rpx 22rpx; margin-top: 23rpx; border: 1rpx dashed var(--cal-line); border-radius: 23rpx; }
.calendar-quote { display: block; font-size: 20rpx; line-height: 1.8; color: var(--cal-muted); text-align: center; margin-top: 25rpx; }
.calendar-loading { padding: 28rpx; border-radius: 38rpx; background: var(--cal-paper); }
.skeleton-week { height: 40rpx; border-radius: 12rpx; background: rgba(135, 108, 66, 0.065); }
.skeleton-month { height: 520rpx; margin-top: 23rpx; border-radius: 22rpx; background: rgba(135, 108, 66, 0.045); }
.state-caption { display: block; text-align: center; margin-top: 24rpx; color: var(--cal-muted); font-size: 22rpx; }
.app-page .page-fab { position: fixed; right: 36rpx; bottom: 154rpx; bottom: calc(154rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; padding: 0; border-radius: 35rpx; background: var(--cal-accent); color: #fffdf7; box-shadow: 0 10rpx 28rpx rgba(94, 72, 39, 0.18); z-index: 20; }
.button-pressed { opacity: 0.8; transform: scale(0.97); }
.card-pressed { opacity: 0.9; transform: scale(0.985); }
.date-pressed { opacity: 0.7; }
.theme-mint .calendar-paper, .theme-cherry .calendar-paper { border-radius: 30rpx; }
@media (max-width: 350px) {
  .calendar-content { padding-left: 27rpx; padding-right: 27rpx; }
  .month-title { font-size: 38rpx; }
  .calendar-controls .month-arrow { width: 47rpx; }
  .schedule { padding-left: 18rpx; padding-right: 18rpx; }
  .month-schedule .schedule-icon { margin-right: 12rpx; }
  .schedule-tail { font-size: 18rpx; margin-left: 10rpx; }
  .schedule-name { font-size: 22rpx; }
}
