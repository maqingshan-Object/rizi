.privacy-page{padding-bottom:0}.privacy-body{padding-top:30rpx}.privacy-intro{margin-bottom:30rpx}.privacy-mark{width:88rpx;height:88rpx;border-radius:30rpx;background:var(--soft);display:flex;align-items:center;justify-content:center;margin-bottom:23rpx}.content-title{display:block;font-size:40rpx;font-weight:600;line-height:1.6;letter-spacing:1rpx}.privacy-subtitle{display:block;font-size:24rpx;line-height:1.8;margin-top:10rpx}.privacy-lead{display:block;font-size:21rpx;line-height:1.8;margin:0 2rpx 26rpx}.privacy-status{display:block;background:var(--soft);border-radius:25rpx;padding:26rpx;margin-bottom:16rpx}.status-title{display:block;color:var(--accent);font-size:27rpx;font-weight:500;line-height:1.7;margin-bottom:10rpx}.status-description{display:block;font-size:24rpx;line-height:1.85}.legal-paper{padding:9rpx 28rpx}.legal-section{padding:28rpx 0;border-bottom:1rpx solid #d9ceba66}.last-section{border-bottom:0}.legal-heading{display:flex;align-items:center;gap:13rpx;font-size:28rpx;line-height:1.6;font-weight:500;margin-bottom:18rpx}.section-number{color:var(--accent);background:var(--soft);font-size:20rpx;font-weight:400;width:43rpx;height:43rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.legal-paragraph{display:block;font-size:25rpx;line-height:1.95;overflow-wrap:break-word}.legal-paragraph+.legal-paragraph{margin-top:14rpx}.privacy-note{display:flex;align-items:center;justify-content:center;gap:14rpx;margin:30rpx 0;font-size:21rpx;line-height:1.8}.privacy-cat{width:67rpx;height:62rpx;flex-shrink:0}.back-button{width:100%}.return-note{display:block;font-size:20rpx;line-height:1.9;margin-top:20rpx;text-align:center}.safe-bottom{height:calc(40rpx + env(safe-area-inset-bottom))}
