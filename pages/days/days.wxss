.app-page {
  --days-ink: #594d3e;
  --days-muted: #a0937e;
  --days-accent: #876c42;
  --days-feature: #f7e8bf;
  --days-paper: #fffdf7;
  --days-pink: #f2d8d6;
  --days-mint: #e2eadb;
  --days-yellow: #f7e8bf;
  --days-blue: #dfe9ed;
  min-height: 100vh;
  color: var(--days-ink);
}
.theme-cherry {
  --days-ink: #70535a;
  --days-muted: #ab8c91;
  --days-accent: #a35965;
  --days-feature: #f7dfe2;
  --days-paper: #fffaf7;
  --days-pink: #f2cdd2;
  --days-mint: #e9e7d8;
  --days-yellow: #f5e4cc;
  --days-blue: #eae2e5;
}
.theme-mint {
  --days-ink: #4d6258;
  --days-muted: #91a096;
  --days-accent: #526f63;
  --days-feature: #dfeadf;
  --days-paper: #ffffff;
  --days-pink: #ede8e0;
  --days-mint: #dfeadf;
  --days-yellow: #ece9de;
  --days-blue: #e0e8e6;
}
.days-content {
  padding: 12rpx 36rpx 190rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.days-content button, .page-fab {
  box-sizing: border-box;
  margin: 0;
  font-family: inherit;
  font-weight: normal;
  line-height: 1.5;
  color: inherit;
}
.days-content button::after, .page-fab::after { border: 0; }
.guest-banner {
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  background: rgba(135, 108, 66, 0.06);
  color: var(--days-muted);
  font-size: 21rpx;
  line-height: 1.5;
}
.guest-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--days-accent);
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.65;
}
.home-head { position: relative; min-height: 170rpx; margin-bottom: 24rpx; }
.date-line { display: block; color: var(--days-muted); font-size: 21rpx; margin-bottom: 15rpx; }
.home-title { display: block; font-size: 42rpx; font-weight: 600; letter-spacing: 1rpx; padding-right: 125rpx; }
.home-subtitle { display: block; color: var(--days-muted); font-size: 22rpx; margin-top: 12rpx; padding-right: 132rpx; }
.head-cat { position: absolute; right: -8rpx; top: 22rpx; width: 151rpx; height: 145rpx; transform: rotate(4deg); }
.category-tabs { display: flex; align-items: center; margin-bottom: 28rpx; }
.category-tabs .category-button {
  flex: 1;
  min-width: 0;
  padding: 13rpx 0;
  margin-right: 12rpx;
  border: 1rpx solid rgba(135, 108, 66, 0.12);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 23rpx;
  color: var(--days-muted);
  white-space: nowrap;
}
.category-tabs .category-button:last-child { margin-right: 0; }
.category-tabs .is-active { color: #fffdf7; background: var(--days-accent); border-color: var(--days-accent); }
.days-content .feature-event {
  width: 100%;
  padding: 32rpx 34rpx 27rpx;
  text-align: left;
  position: relative;
  overflow: hidden;
  border-radius: 42rpx;
  border: 1rpx solid rgba(135, 108, 66, 0.12);
  background: var(--days-feature);
}
.feature-border { position: absolute; top: 17rpx; right: 17rpx; bottom: 17rpx; left: 17rpx; border: 1rpx dashed rgba(135, 108, 66, 0.22); border-radius: 30rpx; pointer-events: none; }
.event-top { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 2; }
.event-heading { display: flex; align-items: center; flex: 1; min-width: 0; font-size: 26rpx; font-weight: 500; }
.event-heading app-icon { margin-right: 12rpx; flex-shrink: 0; }
.event-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.feature-pill { margin-left: 12rpx; padding: 6rpx 12rpx; border-radius: 22rpx; font-size: 18rpx; background: rgba(255, 253, 247, 0.55); color: var(--days-accent); flex-shrink: 0; }
.feature-status { display: block; margin-top: 24rpx; font-size: 21rpx; color: var(--days-accent); }
.feature-count { display: flex; align-items: baseline; position: relative; z-index: 1; padding-right: 212rpx; min-height: 112rpx; }
.feature-number { font-family: 'Avenir Next', 'Helvetica Neue', sans-serif; font-size: 105rpx; font-weight: 500; letter-spacing: -5rpx; line-height: 1.12; word-break: break-all; }
.feature-unit { margin-left: 12rpx; font-size: 25rpx; color: var(--days-accent); white-space: nowrap; }
.feature-cat { position: absolute; right: 20rpx; bottom: 62rpx; width: 184rpx; height: 172rpx; transform: rotate(-5deg); pointer-events: none; }
.feature-phrase { display: block; margin-top: 8rpx; color: var(--days-accent); font-size: 19rpx; opacity: 0.8; }
.event-footer { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; color: var(--days-accent); font-size: 19rpx; margin-top: 23rpx; opacity: 0.85; }
.event-link { display: flex; align-items: center; flex-shrink: 0; margin-left: 10rpx; }
.event-link app-icon { margin-left: 5rpx; }
.cards-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 22rpx -10rpx 0; }
.days-content .event-card {
  margin: 0 10rpx 20rpx;
  padding: 0;
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid rgba(135, 108, 66, 0.1);
  border-radius: 32rpx;
  background: var(--days-paper);
  text-align: left;
}
.event-band { display: flex; align-items: center; padding: 16rpx 22rpx; font-size: 23rpx; }
.event-band app-icon { margin-right: 10rpx; flex-shrink: 0; }
.small-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tint-pink { background: var(--days-pink); }
.tint-mint { background: var(--days-mint); }
.tint-yellow { background: var(--days-yellow); }
.tint-blue { background: var(--days-blue); }
.event-card-body { padding: 19rpx 23rpx 23rpx; position: relative; overflow: hidden; }
.event-card-body > text, .event-card-body > view { position: relative; z-index: 1; }
.small-category-art { position: absolute; right: -10rpx; top: 8rpx; width: 152rpx; height: 162rpx; opacity: 0.3; pointer-events: none; }
.feature-art { position: absolute; right: 20rpx; bottom: 44rpx; width: 246rpx; height: 254rpx; opacity: 0.92; pointer-events: none; }
.feature-holiday { display: block; position: relative; font-size: 22rpx; margin-top: 18rpx; color: var(--days-accent); }
.small-holiday { display: block; font-size: 19rpx; margin-bottom: 6rpx; color: var(--days-accent); }
.sort-note { display: block; font-size: 19rpx; color: var(--days-muted); margin: -9rpx 4rpx 16rpx; }
.theme-mint .feature-art { opacity: 0.24; }
.theme-mint .small-category-art { opacity: 0.09; }
.small-status { display: block; color: var(--days-muted); font-size: 19rpx; margin-bottom: 4rpx; }
.small-count { display: flex; align-items: baseline; }
.small-number { font-family: 'Avenir Next', 'Helvetica Neue', sans-serif; font-size: 60rpx; font-weight: 500; letter-spacing: -2rpx; line-height: 1.1; word-break: break-all; }
.small-unit { margin-left: 8rpx; font-size: 20rpx; color: var(--days-muted); white-space: nowrap; }
.small-date { display: block; margin-top: 15rpx; font-size: 18rpx; color: var(--days-muted); }
.home-quote { display: block; text-align: center; font-size: 20rpx; color: var(--days-muted); margin-top: 29rpx; line-height: 1.8; }
.page-state { text-align: center; border-radius: 34rpx; padding: 55rpx 32rpx; background: var(--days-paper); }
.empty-cat { width: 160rpx; height: 145rpx; display: block; margin: 0 auto 24rpx; }
.state-icon { color: var(--days-accent); display: flex; justify-content: center; margin-bottom: 28rpx; }
.state-title { display: block; font-size: 29rpx; font-weight: 500; }
.state-description { display: block; color: var(--days-muted); font-size: 24rpx; line-height: 1.9; margin-top: 16rpx; }
.days-content .state-action { display: inline-block; font-size: 25rpx; padding: 18rpx 35rpx; margin-top: 28rpx; border-radius: 25rpx; background: var(--days-accent); color: #fffdf7; }
.skeleton { overflow: hidden; border-radius: 34rpx; background: rgba(135, 108, 66, 0.07); }
.skeleton-feature { height: 335rpx; padding: 32rpx; box-sizing: border-box; }
.skeleton-line { border-radius: 12rpx; background: rgba(135, 108, 66, 0.09); }
.skeleton-title { width: 55%; height: 28rpx; }
.skeleton-number { width: 32%; height: 100rpx; margin-top: 33rpx; }
.skeleton-date { width: 42%; height: 20rpx; margin-top: 28rpx; }
.skeleton-card { height: 240rpx; margin: 0 10rpx; }
.state-caption { display: block; text-align: center; font-size: 22rpx; margin-top: 24rpx; color: var(--days-muted); }
.app-page .page-fab { position: fixed; right: 36rpx; bottom: 154rpx; bottom: calc(154rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; padding: 0; border-radius: 35rpx; background: var(--days-accent); color: #fffdf7; box-shadow: 0 10rpx 28rpx rgba(94, 72, 39, 0.18); z-index: 20; }
.button-pressed { opacity: 0.8; transform: scale(0.97); }
.card-pressed { opacity: 0.9; transform: scale(0.985); }
.theme-cherry .feature-event { border-radius: 32rpx; }
.theme-mint .head-cat, .theme-mint .feature-cat, .theme-mint .feature-border { display: none; }
.theme-mint .home-title, .theme-mint .home-subtitle { padding-right: 0; }
.theme-mint .feature-count { padding-right: 0; }
.theme-mint .feature-event, .theme-mint .event-card { border-radius: 28rpx; }
/* 首页「提醒还没开启」提示条：只在有已开启提醒但未授权的日子时出现 */
.reminder-notice {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: rgba(186, 117, 23, 0.10);
  border: 1rpx solid rgba(186, 117, 23, 0.26);
}
.notice-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: rgba(186, 117, 23, 0.16);
  color: var(--days-accent);
}
.notice-body { flex: 1; display: flex; flex-direction: column; }
.notice-title { display: block; font-size: 25rpx; color: var(--days-ink); }
.notice-desc { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--days-muted); line-height: 1.5; }
.notice-time { display: block; margin-top: 4rpx; font-size: 21rpx; color: var(--days-accent); }
.notice-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fffdf7;
  background: var(--days-accent);
}

/* 已开启提醒：卡片上的铃铛徽标 —— 实心底色 + 白色铃铛，保证一眼可见 */
.reminder-bell {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  padding: 5rpx;
  border-radius: 12rpx;
  background: var(--days-accent);
}
.band-bell { margin-left: auto; }

@media (max-width: 350px) {
  .days-content { padding-left: 28rpx; padding-right: 28rpx; }
  .home-title { font-size: 38rpx; }
  .feature-pill { font-size: 17rpx; padding: 5rpx 8rpx; }
  .feature-number { font-size: 96rpx; }
  .small-number { font-size: 55rpx; }
  .notice-desc { font-size: 20rpx; }
  .notice-action { padding: 8rpx 16rpx; font-size: 20rpx; }
  .feature-art { width: 206rpx; height: 212rpx; }
  .feature-count { padding-right: 176rpx; }
}
.capsule-banner{display:flex;align-items:center;gap:12rpx;margin:0 0 22rpx;padding:20rpx 24rpx;border-radius:22rpx;background:var(--soft);border:1rpx solid var(--accent)}.capsule-banner-icon{font-size:26rpx}.capsule-banner-text{flex:1;font-size:24rpx;color:var(--accent);font-weight:500}.capsule-banner-arrow{font-size:24rpx;color:var(--accent)}
.guest-banner{display:flex;align-items:center;gap:14rpx}.guest-banner .guest-text{flex:1;min-width:0}.guest-banner .guest-title{display:block;font-size:23rpx}.guest-banner .guest-sub{display:block;font-size:20rpx;color:var(--muted);margin-top:4rpx}.guest-login{margin:0;padding:12rpx 26rpx;font-size:23rpx;line-height:1.4;border-radius:999rpx;background:var(--accent);color:#fff;flex-shrink:0}

/* 访客提示条 + 登录按钮：整体提亮，让 CTA 明显可点 ✅ */
.guest-banner{display:flex;align-items:center;gap:14rpx;opacity:1;
  padding:22rpx 24rpx;border-radius:22rpx;
  background:var(--paper);border:1rpx solid var(--accent);
  box-shadow:0 4rpx 14rpx rgba(135,108,66,.10)}
.guest-banner .guest-dot{background:var(--accent);opacity:1;flex-shrink:0}
.guest-banner .guest-text{flex:1;min-width:0;opacity:1}
.guest-banner .guest-title{display:block;font-size:23rpx;color:var(--ink);opacity:1}
.guest-banner .guest-sub{display:block;font-size:20rpx;color:var(--accent);margin-top:4rpx;opacity:1}
.guest-login{margin:0;flex-shrink:0;min-width:130rpx;
  padding:14rpx 30rpx;font-size:24rpx;line-height:1.35;font-weight:600;
  border:none;border-radius:999rpx;color:#fff;opacity:1;
  background-color:var(--accent);
  box-shadow:0 6rpx 16rpx rgba(135,108,66,.38)}
.guest-login::after{border:none}

/* ⚠️ 父级 opacity 会让整条 banner（含按钮）一起变淡，子元素设 opacity:1 也救不回来，
   所以这几条必须 !important 强压旧规则。 */
.guest-banner{opacity:1 !important;background:#fffdf7 !important;border:1rpx solid rgba(135,108,66,.35) !important;
  box-shadow:0 4rpx 14rpx rgba(135,108,66,.10) !important}
.guest-banner .guest-text{opacity:1 !important}
.guest-banner .guest-title{color:#3a332a !important;opacity:1 !important}
.guest-banner .guest-sub{color:#8a6a45 !important;opacity:1 !important}
.guest-banner .guest-dot{opacity:1 !important}
/* CTA：换成更亮的蜜金，白字加粗 + 投影，明显可点 */
.guest-login{margin:0 !important;flex-shrink:0 !important;min-width:132rpx !important;
  padding:16rpx 32rpx !important;font-size:25rpx !important;font-weight:700 !important;
  line-height:1.35 !important;border:none !important;border-radius:999rpx !important;
  color:#fff !important;opacity:1 !important;
  background-color:#c8894a !important;
  box-shadow:0 6rpx 18rpx rgba(200,137,74,.45) !important}
.guest-login::after{border:none !important}
