.profile-body{padding-top:24rpx}.profile-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:34rpx}.content-title{font-size:44rpx;font-weight:600;letter-spacing:2rpx}.about-button{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center}.profile-card{display:flex;align-items:center;gap:25rpx;margin-bottom:28rpx}.avatar-button{width:132rpx;height:132rpx;flex-shrink:0;border:2rpx solid #d9ceba88;border-radius:44rpx;background:var(--soft);overflow:hidden}.avatar{width:100%;height:100%;padding:0}.avatar-art{padding:8rpx}
.avatar-letter{display:flex;align-items:center;justify-content:center;padding:0;font-size:52rpx;color:var(--accent);font-weight:600;background:var(--soft)}.profile-info{min-width:0;flex:1}.profile-name{display:block;font-size:34rpx;font-weight:500;overflow-wrap:break-word}.profile-description{display:block;font-size:22rpx;line-height:1.7;margin:8rpx 0 12rpx}.profile-link{display:inline-flex;align-items:center;gap:8rpx;color:var(--accent);font-size:22rpx;min-height:48rpx}.profile-guest{display:flex;align-items:center;gap:16rpx;padding:22rpx;border-radius:24rpx;background:var(--soft);margin-bottom:20rpx}.guest-title{display:block;font-size:23rpx}.guest-note{display:block;font-size:21rpx;line-height:1.6;margin-top:5rpx;color:var(--muted)}.stats{display:flex;padding:26rpx 0 16rpx}.stat{flex:1;text-align:center;min-width:0;position:relative}.stat+.stat:before{content:'';position:absolute;left:0;top:16rpx;height:48rpx;border-left:1rpx solid #d9ceba88}.stat-number{display:block;font-size:44rpx;line-height:1.3;font-weight:500;color:var(--accent)}.stat-label{display:block;font-size:22rpx;margin-top:8rpx}.stats-help{font-size:20rpx;text-align:center;margin:0 0 22rpx;line-height:1.7}.form-error{font-size:24rpx;color:#a35965;line-height:1.7;margin-bottom:24rpx}.retry-button{display:inline-block;text-decoration:underline;margin-left:15rpx;font-size:22rpx}.theme-panel{padding:26rpx 22rpx;margin-top:24rpx}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx;font-size:26rpx;margin-bottom:25rpx}.panel-hint{font-size:19rpx}.theme-previews{display:flex;gap:18rpx}.theme-choice{flex:1;min-width:0;text-align:center;padding:4rpx;border-radius:20rpx}.mini-page{height:222rpx;border:2rpx solid transparent;border-radius:20rpx;padding:16rpx 12rpx 10rpx;position:relative;overflow:hidden}.selected .mini-page{border-color:var(--accent);box-shadow:0 0 0 4rpx var(--soft)}.mini-header{position:relative;height:42rpx;display:flex;align-items:center}.mini-title{width:48rpx;height:6rpx;border-radius:5rpx;opacity:.55}.mini-cat{position:absolute;right:0;top:-6rpx;width:48rpx;height:48rpx}.mini-feature{height:87rpx;border-radius:12rpx;position:relative;padding:12rpx}.mini-line{width:48rpx;height:5rpx;border-radius:4rpx;opacity:.45}.mini-count{font-size:34rpx;display:block;text-align:left;margin-top:6rpx}.mini-heart-cat{position:absolute;right:5rpx;bottom:5rpx;width:59rpx;height:55rpx}.mini-cards{display:flex;gap:7rpx;margin-top:10rpx}.mini-cards view{flex:1;height:36rpx;border-radius:7rpx;opacity:.65}.mini-tabs{display:flex;justify-content:space-around;margin-top:12rpx}.mini-tabs view{height:6rpx;width:17rpx;border-radius:6rpx;background:#d9ceba}.theme-check{position:absolute;right:7rpx;top:7rpx;display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;border-radius:50%}.theme-lock{position:absolute;right:7rpx;top:7rpx;display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;border-radius:50%;opacity:.9}.store-entry{display:flex;align-items:center;gap:12rpx;width:100%;margin-top:24rpx;padding:22rpx 4rpx 8rpx;text-align:left;border-top:1rpx solid rgba(217,206,186,.55)}.store-entry-title{font-size:25rpx;font-weight:500}.store-entry-hint{flex:1;font-size:21rpx}.theme-name{display:block;font-size:22rpx;margin-top:17rpx;color:var(--ink)}.selected .theme-name{color:var(--accent);font-weight:600}.theme-caption{display:block;font-size:18rpx;margin-top:5rpx}.settings{margin-top:29rpx}.setting-row{display:flex;align-items:center;gap:20rpx;min-height:99rpx;text-align:left;border-bottom:1rpx solid #d9ceba66;padding:22rpx 2rpx}.setting-title{flex:1;min-width:0;font-size:26rpx}.setting-note{font-size:21rpx;flex-shrink:0}.clear-button{width:100%;margin-top:30rpx;font-size:23rpx}.signout-button{text-align:center;width:100%;padding:28rpx;font-size:24rpx}.profile-footer{text-align:center;line-height:1.9;margin-top:44rpx;font-size:24rpx;letter-spacing:2rpx}.footer-small{display:block;font-size:19rpx;letter-spacing:1rpx;margin-top:7rpx}.safe-bottom{height:20rpx}
/* 未登录时的登录入口：做得明显一些 ✅ */.profile-login-cta{opacity:1 !important;background-color:#c8894a !important;border:none !important;border-radius:999rpx !important;padding:20rpx 28rpx !important;min-height:0 !important;box-shadow:0 6rpx 18rpx rgba(200,137,74,.40) !important}.profile-login-cta text,.profile-login-cta .app-icon{color:#fff !important}.profile-login-cta::after{border:none !important}
