n-top:12rpx}.login-help{margin-bottom:26rpx}.login-button{width:100%;margin-top:24rpx}.login-button[disabled]{background:var(--accent);color:var(--paper);opacity:.5}.after-note{text-align:center;margin-top:19rpx;font-size:21rpx}.error-box{background:var(--soft);border-left:5rpx solid #a35965;border-radius:12rpx;padding:19rpx;margin-top:23rpx;font-size:24rpx;line-height:1.8;color:#984c59;overflow-wrap:break-word}.error-box text{display:block}.error-code{font-size:20rpx;margin-top:8rpx}.identity-status{display:flex;align-items:center;gap:10rpx;color:var(--accent);font-size:24rpx;margin-bottom:20rpx}.form-group{margin-top:26rpx}.form-label{display:block;font-size:25rpx;margin-bottom:15rpx}.choose-avatar{width:142rpx;height:142rpx;position:relative;margin:8rpx auto 20rpx;border-radius:44rpx;background:var(--soft);border:1rpx solid #d9ceba88}.chosen-avatar{width:100%;height:100%;padding:0;border-radius:44rpx}.chosen-art{padding:8rpx}.avatar-edit{position:absolute;right:-8rpx;bottom:-5rpx;width:43rpx;height:43rpx;border-radius:15rpx;background:var(--accent);display:flex;align-items:center;justify-content:center;border:3rpx solid var(--paper)}.nickname-input{width:100%;height:92rpx;padding:0 24rpx;border-radius:22rpx;border:1rpx solid #d9ceba;background:var(--app);color:var(--ink);font-size:27rpx}.saved-message{display:block;color:var(--accent);font-size:24rpx;line-height:1.8;margin-top:22rpx}.guest-button{margin-top:28rpx;width:100%}.login-footer{font-size:21rpx;line-height:1.9;text-align:center;margin:24rpx 12rpx 15rpx}.safe-bottom{height:calc(35rpx + env(safe-area-inset-bottom))}
