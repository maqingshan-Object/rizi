page{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;background:#faf6eb;color:#51493f;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{font:inherit;border-radius:0;background:none;margin:0;padding:0;line-height:inherit;color:inherit}button::after{border:0}button[disabled]{opacity:.55;background:inherit;color:inherit}button:active{opacity:.8;transform:scale(.985)}.app-page{--app:#faf6eb;--paper:#fffdf7;--ink:#51493f;--muted:#a1937b;--accent:#876c42;--soft:#f6e9c9;--pink:#f2d8d6;--mint:#e2eadb;--yellow:#f7e8bf;--blue:#dfe9ed;min-height:100vh;background:var(--app);color:var(--ink);padding-bottom:190rpx}.theme-cherry{--app:#fcf2f0;--paper:#fffaf7;--accent:#a35965;--soft:#f7dfe2;--pink:#f2cdd2;--mint:#e9e7d8;--yellow:#f5e4cc;--blue:#eae2e5}.theme-mint{--app:#f2f6f2;--paper:#fff;--accent:#526f63;--soft:#e2ece5;--pink:#ede8e0;--mint:#dfeadf;--yellow:#ece9de;--blue:#e0e8e6}.page-body{padding:30rpx 40rpx}.paper,.soft-card{background:var(--paper);border:1rpx solid #d9ceba66;border-radius:36rpx}.btn-primary{background:var(--accent);color:#fffdf7;padding:26rpx 22rpx;border-radius:24rpx;text-align:center;font-size:26rpx;line-height:1.5}.btn-secondary{border:1rpx solid #d5c5a7;background:var(--paper);padding:24rpx 20rpx;border-radius:22rpx;text-align:center;font-size:24rpx}.muted{color:var(--muted)}.pill{font-size:18rpx;padding:8rpx 16rpx;border-radius:24rpx;background:#fff9eb99;color:#a38b62;line-height:1.4}.empty-state{text-align:center;color:var(--muted);font-size:26rpx;padding:75rpx 25rpx;line-height:1.9}.empty-state .empty-hint{font-size:22rpx;margin:12rpx 0 30rpx}.empty-state app-icon{display:block;margin:0 auto 20rpx}.section-title{font-size:27rpx;font-weight:500;margin:35rpx 0 24rpx}.fab{position:fixed;right:38rpx;bottom:calc(180rpx + env(safe-area-inset-bottom));width:88rpx;height:88rpx;border:6rpx solid var(--paper);border-radius:30rpx;background:var(--accent);display:flex;justify-content:center;align-items:center;box-shadow:0 8rpx 25rpx #7b694327;z-index:8}.form-label{display:block;font-size:23rpx;color:#907d61;margin-bottom:14rpx}.form-input{width:100%;background:var(--paper);border:1rpx solid #dccfb6;border-radius:22rpx;padding:22rpx 24rpx;font-size:26rpx;min-height:86rpx}.form-group{margin-bottom:30rpx}.form-help{font-size:21rpx;color:var(--muted);line-height:1.85;margin:20rpx 0}.form-error{font-size:23rpx;line-height:1.8;color:#a7585b;margin:18rpx 0}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}.guest-banner{background:#f1e9d755;border:1rpx solid #e7ddca;border-radius:18rpx;padding:17rpx 22rpx;color:#998667;font-size:20rpx;display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.guest-banner .banner-link{color:var(--accent);font-weight:500}.count-font{font-family:"Avenir Next",-apple-system,sans-serif;font-variant-numeric:tabular-nums}.error-banner{background:#f9e8e1;color:#9c5e55;padding:20rpx 24rpx;border-radius:18rpx;font-size:22rpx;line-height:1.8;margin-bottom:24rpx}.theme-mint .head-cat,.theme-mint .feature-cat{display:none}.theme-mint .feature-event{background:var(--mint)}.theme-mint .feature-event::before{display:none}.subpage{padding-bottom:60rpx}.legal-text{font-size:25rpx;line-height:2;color:#8b785b}.legal-text .legal-title{font-weight:500;color:#67573f;margin:30rpx 0 12rpx}.loading{background:#f0e8d7;border-radius:30rpx;height:150rpx;margin-bottom:24rpx;opacity:.55}.content-title{font-size:47rpx;font-weight:600;letter-spacing:1rpx;margin:10rpx 0 20rpx}.content-subtitle{font-size:23rpx;color:var(--muted);margin-bottom:32rpx}
